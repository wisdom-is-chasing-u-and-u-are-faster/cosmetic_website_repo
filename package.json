{
  "name": "cosmetic-store-platform",
  "version": "1.0.0",
  "description": "Enterprise Online Cosmetic Store Platform - Headless Composable Commerce Implementation",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
