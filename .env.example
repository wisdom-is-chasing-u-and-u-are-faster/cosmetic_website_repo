# Environment Configuration for Enterprise Online Cosmetic Store Platform
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=sqlite:///./cosmetics_store.db
DATABASE_FILE=cosmetics_store.db

# Distributed Cache & Reservation Locks
REDIS_URL=redis://localhost:6379/0

# Security & HMAC Secret for 3PL Webhooks
SECRET_KEY=dev-secret-key-change-in-production-1234567890
WEBHOOK_3PL_HMAC_SECRET=secret-webhook-key-3pl

# Third-party Gateways (Stripe Sandbox)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_key

# 3PL Logistics Dispatch Endpoint
THREE_PL_DISPATCH_URL=https://api.mock-3pl.com/v1/shipments
