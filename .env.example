# ==============================================================================
# 12-Factor Environment Configuration — Personalized Skincare Commerce Engine
# ==============================================================================

# Server & Runtime Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (SQLite default with PostgreSQL DDL compatibility)
DATABASE_PATH=skincare_commerce.db
DATABASE_URL=sqlite:///./skincare_commerce.db
DB_POOL_SIZE=10
DB_TIMEOUT=30

# Redis Cache & Hold Lock Engine
REDIS_URL=redis://localhost:6379/0
INVENTORY_RESERVATION_TTL_SECONDS=600

# Client Storefront API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Dual PSP Gateway Configurations (Sandbox / Mock)
STRIPE_API_KEY=sk_test_mock_stripe_key_12345
ADYEN_API_KEY=mock_adyen_key_67890
PSP_ROUTING_PRIMARY=stripe
PSP_FAILOVER_TIMEOUT_MS=500
