# Environment Variables for Online Cosmetic Store Platform
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=sqlite:///./cosmetics_store.db
DATABASE_FILE=cosmetics_store.db
SQLITE_DB_PATH=cosmetics_store.db
DB_POOL_SIZE=10

# Cache & Locks (Redis)
REDIS_URL=redis://localhost:6379/0

# Security & Secrets
SECRET_KEY=dev-secret-key-change-in-production-1234567890
WEBHOOK_3PL_HMAC_SECRET=secret-webhook-key-3pl
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Third-party Gateways (Sandbox/Mock)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_key

# 3PL Logistics Endpoint
THREE_PL_DISPATCH_URL=https://api.mock-3pl.com/v1/shipments

# Platform & Cloud Integration
PROJECT_ID=persistent-genai
GOOGLE_CLOUD_PROJECT=persistent-genai
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
APP_URL=http://localhost:8000
AGENT_VERSION=1.0.0
JIRA_MCP_URL=http://localhost:8080
JIRA_TOKEN=mock-jira-token
DEFAULT_PR_REVIEWERS=senior-architect
